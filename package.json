{
  "name": "incant-online",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based, voice-first action RPG. Say it. Cast it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manifest": "node scripts/build-manifest.mjs",
    "check:api": "node scripts/check-api.mjs",
    "judge-test": "node scripts/judge-test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "fuse.js": "^7.5.0",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
