# Copy to .env (git-ignored) for local development.
# On Vercel, set these in Project Settings → Environment Variables.
# Server-side only: never prefix with VITE_ (that would ship them to the browser).

ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Leave LLM_MODE unset: mock mode (local keyword parser, no LLM calls) is used while
# ANTHROPIC_API_KEY is empty, and Claude is used as soon as a key is set.
# Set LLM_MODE=mock to force mock mode even with a key.
# LLM_MODE=mock

# Optional: the Arbiter's cloud voice (ElevenLabs text-to-speech via /api/tts). Without a key the
# game uses the browser's own voice. Only the Arbiter's lines (text) are sent, never player audio.
# Needs a paid plan (Starter or above): free accounts can't use Voice Library voices through the
# API, and the free plan is non-commercial only.
ELEVENLABS_API_KEY=
# TTS_VOICE=6WwXjDDEMyNmFG95zycZ   # voice_id; default "Eldrin - Crisp British Baritone"
# TTS_MODEL=eleven_flash_v2_5      # real-time model; eleven_multilingual_v2 for richer, slower speech
